# ── OmniMove — Local Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your local values.
# NEVER commit .env to git — it is already in .gitignore.
#
# How to load in IntelliJ:
#   Run > Edit Configurations > select OmnimoveApplication
#   > Modify options > Environment variables > paste each line as KEY=VALUE
# ──────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omnimovedb
SPRING_DATASOURCE_USERNAME=omnimove
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# ── Redis ─────────────────────────────────────────────────────────────────
# Must match the REDIS_PASSWORD set in docker-compose.yml
SPRING_REDIS_PASSWORD=your_redis_password_here

# ── JWT (use any long random string — min 32 chars) ───────────────────────
JWT_SECRET=replace-with-a-random-256bit-secret-string

# ── InfluxDB ──────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8087
INFLUX_TOKEN=your_influxdb_token_here

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Generate a Gmail App Password at: myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16char_gmail_app_password

# ── CassiTrack connection (must match SSE_API_TOKEN in CassiTrack) ────────
CASSITRACK_URL=http://localhost:8280/cassitrack/api/v1
CASSITRACK_API_TOKEN=your_sse_api_token_here
CASSITRACK_NETEX_URL=http://localhost:8280/cassitrack/api/static/netex

# ── App base URL (used in email links) ───────────────────────────────────
# LOCAL:  APP_BASE_URL=http://localhost:8180
# SERVER: APP_BASE_URL=http://193.205.60.151:8180
APP_BASE_URL=http://localhost:8180

# ── CORS ──────────────────────────────────────────────────────────────────
# LOCAL:      CORS_ALLOWED_ORIGINS=http://localhost:8180,http://localhost:3000
# SERVER:     CORS_ALLOWED_ORIGINS=http://193.205.60.151:8180,http://193.205.60.151:8280
# WITH DOMAIN (future): CORS_ALLOWED_ORIGINS=https://omnimove.unicas.it,https://cassitrack.unicas.it
CORS_ALLOWED_ORIGINS=http://localhost:8180,http://localhost:3000

# ── External APIs (optional — app degrades gracefully if not set) ─────────
WEATHER_API_KEY=your_openweathermap_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Privacy notice version ────────────────────────────────────────────────
# Bump when the text of privacy.html / cookie-policy.html materially changes:
# consents recorded under an older version stop counting and are asked again.
# Keep it in sync with POLICY_VERSION in omnimove-consent.js.
PRIVACY_POLICY_VERSION=2026-08-28

# ── Research pipeline (three-tier data lifecycle) ─────────────────────────
# See docs/privacy/DPIA-omnimove-cassitrack.md before turning this on.
#
# LEAVE FALSE unless you are specifically testing the pipeline: it moves
# personal data between tiers and DELETES journeys older than the retention
# window. Leaving it false is safe for ordinary local development.
#
# Caveat for production: while it is false, journeys are kept forever, which
# contradicts the 12-month retention that privacy.html § 7 tells users.
RESEARCH_ENABLED=false

# Required (min 32 chars) only when RESEARCH_ENABLED=true — the app refuses to
# start otherwise. MUST stay the same forever once the pipeline has run: a new
# salt produces new pseudonyms, splitting one person into two subjects and
# leaving earlier objections unhonoured. Never store it in the database.
RESEARCH_PSEUDONYM_SALT=

# Tier 1 retention (must match what privacy.html § 7 states)
RESEARCH_OPERATIONAL_RETENTION_DAYS=365
# Tier 2 (pseudonymous) retention
RESEARCH_TIER2_RETENTION_DAYS=3650
# Small-cell suppression threshold for published aggregates; minimum 5
RESEARCH_K_THRESHOLD=10
# ── CassiTrack — Local Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your local values.
# NEVER commit .env to git — it is already in .gitignore.
#
# How to load in IntelliJ:
#   Run > Edit Configurations > select CassitrackApplication
#   > Modify options > Environment variables > paste each line as KEY=VALUE
# ──────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cassitrack
SPRING_DATASOURCE_USERNAME=cassitrack
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# ── Redis ─────────────────────────────────────────────────────────────────
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_redis_password_here

# ── JWT (use any long random string — min 32 chars) ───────────────────────
JWT_SECRET=replace-with-a-random-256bit-secret-string

# ── InfluxDB ──────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_token_here
INFLUX_ORG=unicas
INFLUX_BUCKET=vehicle_telemetry

# ── SSE internal API token (must match CASSITRACK_API_TOKEN in OmniMove) ──
SSE_API_TOKEN=your_sse_api_token_here

# ── MQTT ──────────────────────────────────────────────────────────────────
# CassiTrack's bundled Mosquitto (docker compose --profile local-broker).
# Local development only: set MQTT_BROKER_ENABLED=false wherever the broker is
# operated by someone else — the server ingests via MQTT_OBU_* alone.
MQTT_BROKER_ENABLED=true
MQTT_BROKER_URL=tcp://localhost:1883
# Set these when the Mosquitto broker has password_file authentication enabled
MQTT_USERNAME=cassitrack
MQTT_PASSWORD=your_mqtt_password_here

# ── CORS ──────────────────────────────────────────────────────────────────
# LOCAL:      CORS_ALLOWED_ORIGINS=http://localhost:8280,http://localhost:8180
# SERVER:     CORS_ALLOWED_ORIGINS=http://193.205.60.151:8280,http://193.205.60.151:8180
# WITH DOMAIN (future): CORS_ALLOWED_ORIGINS=https://cassitrack.unicas.it,https://omnimove.unicas.it
CORS_ALLOWED_ORIGINS=http://localhost:8280,http://localhost:8180

# ── External APIs (optional — app degrades gracefully if not set) ─────────
WEATHER_API_KEY=your_openweathermap_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ── MQTT OBU broker (external ESP32 feed / professor's simulate_bus.py) ───
# Optional second inbound MQTT connection. Leave disabled for local dev.
# When enabled, cassitrack subscribes to the compact OBU schema published on
# cassitrack/obu/{id}/pos and translates it via ObuPositionPayload.
MQTT_OBU_ENABLED=false
MQTT_OBU_URL=ssl://devaidalab.unicas.it:8883
# Unique per instance — use your own name, e.g. cassitrack-obu-<yourname>.
# If left unset the app appends a random suffix so you cannot collide.
MQTT_OBU_CLIENT_ID=cassitrack-obu-CHANGEME
MQTT_OBU_USERNAME=esp32
MQTT_OBU_PASSWORD=
MQTT_OBU_TOPIC=cassitrack/obu/+/pos

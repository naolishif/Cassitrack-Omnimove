# ── CassiTrack — Local Environment Variables ──────────────────────────────
# Real values for local development. NEVER commit this file.

# ── PostgreSQL ────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cassitrack
SPRING_DATASOURCE_USERNAME=cassitrack
SPRING_DATASOURCE_PASSWORD=cassitrack_dev

# ── Redis ─────────────────────────────────────────────────────────────────
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=cassitrack_dev

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=cassitrack-jwt-secret-change-in-production-must-be-long

# ── InfluxDB ──────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=cassitrack-dev-token-change-in-production
INFLUX_ORG=unicas
INFLUX_BUCKET=vehicle_telemetry

# ── SSE internal API token (must match CASSITRACK_API_TOKEN in OmniMove) ──
SSE_API_TOKEN=JfWIYLF6BednHmUkOliUQbHHpuVIIBzqN/DcpJWsXUM=

# ── MQTT ──────────────────────────────────────────────────────────────────
MQTT_BROKER_URL=tcp://localhost:1883
# Leave blank if your local Mosquitto broker has no authentication configured
MQTT_USERNAME=cassitrack-backend
MQTT_PASSWORD=mqtt_password_1

# ── MQTT OBU broker (real ESP32 feed, external TLS broker) ─────────────────
# Second connection: cassitrack subscribes here to the compact OBU schema on
# cassitrack/obu/{id}/pos and translates it internally. Leave MQTT_OBU_URL
# blank to disable. Use the ssl:// scheme for the TLS port (8883).
MQTT_OBU_ENABLED=true
MQTT_OBU_URL=ssl://devaidalab.unicas.it:8883
MQTT_OBU_USERNAME=esp32
MQTT_OBU_PASSWORD=UyR5rYgajGDd@hQ
MQTT_OBU_TOPIC=cassitrack/obu/+/pos

# ── External APIs ─────────────────────────────────────────────────────────
WEATHER_API_KEY=a50cdb6508e8300b5af885e88e9dcb3a
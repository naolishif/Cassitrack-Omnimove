# Maven
.mvn/wrapper/maven-wrapper.jar

# Environment / secrets — NEVER commit these files
# The mosquitto password file holds one hash per broker user, and each developer
# generates their own (see cassitrack-backend/mosquitto/config/mosquitto.conf).
# Versioning it meant the committed hashes could only ever match one person's
# .env — everyone else was silently refused by the broker.
cassitrack-backend/mosquitto/config/passwd
.env
*.env
.env_server
env
.env_server
**/env
**/.env
cassitrack-backend/env
omnimove-backend/env

# ⚠️  SECURITY NOTICE — Git history cleanup required:
# Secrets were committed in early commits (see omnimove-backend/env, cassitrack-backend/env).
# Run: git filter-repo --path cassitrack-backend/env --path omnimove-backend/env --invert-paths
# Then force-push all branches and rotate ALL secrets exposed (see OWASP_SECURITY_AUDIT.md).

